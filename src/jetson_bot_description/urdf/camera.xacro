<?xml version="1.0"?>
<!-- camera-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!-- The IMX219 sits on the chassis's front face, measured on 2026-11-24. It is 5 cm from
         the robot's left side and 12.5 cm from its right, so 3.75 cm left of the centre line,
         and halfway up the 9.7 cm face, which is 15.8 cm ahead of the axle (robot_core.xacro).
         It looks 2.1 deg down with its left side 0.8 deg up, from the iPad standing level on
         the floor in 12 calibration views, all within 0.5 deg of level, with the lens
         calibration of experiment 22. The provisional calibration had given 7.0 and 2.3 deg.
         Yaw wasn't measured. Before, this joint held the old ESP32-CAM's 0.1455 0 0.05 with
         no tilt. Pitch is positive looking down. -->
    <joint name="camera_joint" type="fixed">
        <origin xyz="0.158 0.0375 0.0485" rpy="0.0147 0.0369 0"/>
        <parent link="chassis"/>
        <child link="camera_link"/>
    </joint>

    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <!-- <cylinder radius="0.015" length="0.015"/> -->
                <box size="0.017 0.017 0.017"/>
            </geometry>
            <material name="red"/>
        </visual>
        <xacro:inertial_cylinder mass="0.1" radius="0.035" length="0.025">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="camera_optical_joint" type="fixed">
        <origin xyz="0.005 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
        <parent link="camera_link"/>
        <child link="camera_optical_link"/>
    </joint>

    <link name="camera_optical_link"></link>

    <gazebo reference="camera_link">
        <material>Gazebo/Red</material>
        <sensor name="camera" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <camera>
                <horizontal_fov>1.3962634</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <frame_name>camera_optical_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>
</robot>
