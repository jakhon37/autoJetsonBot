<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
<!-- /home/jetson/myspace/autoJetsonBot/src/my_robot_launch/urdf/robot_core.xacro -->
<!-- <xacro:property name="pi" value="3.14159265359"/>    -->
<xacro:include filename="inertial_macros.xacro" />

    <!-- COLORS FOR ROBOT PARTS -->
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>
        <material name="grey2">
        <color rgba="0.75 0.75 0.75 1"/>
    </material>
    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>
    <material name="green">
        <color rgba="0 1 0 1"/>
    </material>
    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>
    <material name="yellow">
        <color rgba="1 1 0 1"/>
    </material>
    <material name="orange">
        <color rgba="1 0.5 0 1"/>
    </material>
    <material name="purple">
        <color rgba="0.5 0 0.5 1"/>
    </material>
    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>
    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>


    <!-- BASE_FOOTPRINT LINK (The Floor Projection) -->

    <link name="base_footprint">
    </link>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.055" rpy="0 0 0"/>
    </joint>

    <!-- ROBOT BASE LINK (The Center of the Wheels) -->

    <link name="base_link">
    </link>


    <!-- ROBOT CHASSIS LINK-->
    <joint name="chassis_joint" type="fixed">
        <origin xyz="-0.035 0 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="chassis"/>
    </joint>


    <!-- ROBOT CHASSIS -->
    <link name="chassis">
        <visual>
            <origin xyz="0.0975 0 0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.195 0.18 0.1"/>
            </geometry>
            <material name="purple"/>
        </visual>
        <collision>
            <origin xyz="0.0975 0 0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.195 0.18 0.1"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.8" x="0.195" y="0.18" z="0.1">
            <origin xyz="0.0975 0 0.05" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>
    <gazebo reference="chassis">
        <material>Gazebo/White</material>
    </gazebo>

    <!-- ROBOT WHEELS -->

    <!-- LEFT WHEEL -->
    <joint name="left_wheel_joint" type="continuous">
        <origin xyz="0 0.11 -0.02" rpy="-${pi/2} 0 0"/>
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.035" length="0.026"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.035" length="0.026"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.026" radius="0.035">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>

    </link> 
    <gazebo reference="left_wheel">
        <material>Gazebo/Black</material>
        <mu1 value="100.0"/>
        <mu2 value="100.0"/>
        <kp value="1000000.0" />
        <kd value="1.0" />
    </gazebo>

    <!-- RIGHT WHEEL -->
    <joint name="right_wheel_joint" type="continuous">
        <origin xyz="0 -0.11 -0.02" rpy="${pi/2} 0 0"/>
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.035" length="0.026"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.035" length="0.026"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.026" radius="0.035">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link> 
    <gazebo reference="right_wheel">
        <material>Gazebo/Black</material>
        <mu1 value="100.0"/>
        <mu2 value="100.0"/>
        <kp value="1000000.0" />
        <kd value="1.0" />
    </gazebo>   

    <!-- CASTER WHEEL -->
    <joint name="caster_wheel_joint" type="fixed">
        <origin xyz="0.12 0 -0.02" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="caster_wheel"/>
    </joint>

    <link name="caster_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.035"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="0.1" radius="0.035">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link> 
    <gazebo reference="caster_wheel">
        <material>Gazebo/Black</material>
        <mu1 value="0.001"/>
        <mu2 value="0.001"/>
    </gazebo>

    

    <!-- ROBOT LIDAR
    <joint name="lidar_joint" type="fixed">
        <origin xyz="0.1 0 0.135" rpy="0 0 0"/>
        <parent link="chassis"/>
        <child link="lidar"/>
    </joint>

    <link name="lidar">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <geometry>
                <cylinder radius="0.035" length="0.065"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <geometry>
                <cylinder radius="0.035" length="0.065"/>
            </geometry>
        </collision>
    </link> 
    <gazebo reference="lidar">
        <material>Gazebo/Red</material>
    </gazebo> -->
    
</robot>
