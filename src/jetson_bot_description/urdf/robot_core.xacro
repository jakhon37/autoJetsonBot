<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
<!-- /home/jetson/myspace/autoJetsonBot/src/my_robot_launch/urdf/robot_core.xacro -->
<!-- <xacro:property name="pi" value="3.14159265359"/>    -->
<xacro:include filename="inertial_macros.xacro" />

    <!-- COLORS FOR ROBOT PARTS -->
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>
        <material name="grey2">
        <color rgba="0.75 0.75 0.75 1"/>
    </material>
    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>
    <material name="green">
        <color rgba="0 1 0 1"/>
    </material>
    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>
    <material name="yellow">
        <color rgba="1 1 0 1"/>
    </material>
    <material name="orange">
        <color rgba="1 0.5 0 1"/>
    </material>
    <material name="purple">
        <color rgba="0.5 0 0.5 1"/>
    </material>
    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>
    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>


    <!-- BASE_FOOTPRINT LINK (The Floor Projection) -->

    <link name="base_footprint">
    </link>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.056" rpy="0 0 0"/>
    </joint>

    <!-- ROBOT BASE LINK (The Center of the Chassis Floor) -->

    <link name="base_link">
    </link>


    <!-- ROBOT CHASSIS LINK-->
    <joint name="chassis_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="chassis"/>
    </joint>


    <!-- ROBOT CHASSIS -->
    <link name="chassis">
        <visual>
            <origin xyz="0.061 0 0.0485" rpy="0 0 0"/>
            <geometry>
                <box size="0.194 0.178 0.097"/>
            </geometry>
            <material name="purple"/>
        </visual>
        <collision>
            <origin xyz="0.061 0 0.0485" rpy="0 0 0"/>
            <geometry>
                <box size="0.194 0.178 0.097"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="1.2" x="0.194" y="0.178" z="0.097">
            <origin xyz="0.061 0 0.0485" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>
    <gazebo reference="chassis">
        <material>Gazebo/White</material>
    </gazebo>

    <!-- ROBOT WHEELS -->

    <!-- LEFT WHEEL -->
    <joint name="left_wheel_joint" type="continuous">
        <origin xyz="0 0.106 -0.022" rpy="-${pi/2} 0 0"/>
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.034" length="0.026"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.034" length="0.026"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.026" radius="0.034">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>

    </link> 
    <gazebo reference="left_wheel">
        <material>Gazebo/Black</material>
        <mu1 value="100.0"/>
        <mu2 value="100.0"/>
        <kp value="1000000.0" />
        <kd value="1.0" />
    </gazebo>

    <!-- RIGHT WHEEL -->
    <joint name="right_wheel_joint" type="continuous">
        <origin xyz="0 -0.106 -0.022" rpy="${pi/2} 0 0"/>
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="right_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.034" length="0.026"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.034" length="0.026"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.026" radius="0.034">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link> 
    <gazebo reference="right_wheel">
        <material>Gazebo/Black</material>
        <mu1 value="100.0"/>
        <mu2 value="100.0"/>
        <kp value="1000000.0" />
        <kd value="1.0" />
    </gazebo>   

    <!-- CASTER WHEEL -->
    <!-- A swivel caster with a 26 mm wheel, on a plate hung by four bolts 16 mm under the chassis
         floor since the body was rebuilt on 2026-11-15 to 17. Its swivel axis is 0.115 m ahead of
         the axle, and when driving forward the wheel trails about 13 mm behind that axis. Here it
         is a ball of the wheel's size under the swivel axis, nearly without friction, with its
         lowest point on the ground, at z -0.056 in base_link. The swivel, the plate and the bolts
         are drawn without collisions. The sizes were read from photos on 2026-11-26. Before, this
         link was a 68 mm ball. -->
    <joint name="caster_wheel_joint" type="fixed">
        <origin xyz="0.115 0 -0.043" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="caster_wheel"/>
    </joint>

    <xacro:macro name="caster_bolt" params="x y">
        <visual>
            <origin xyz="${x} ${y} 0.03375" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.0015" length="0.0185"/>
            </geometry>
            <material name="grey2"/>
        </visual>
    </xacro:macro>

    <link name="caster_wheel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.013"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <!-- The swivel, from the wheel up to the plate -->
        <visual>
            <origin xyz="0 0 0.01875" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.0125" length="0.0115"/>
            </geometry>
            <material name="grey2"/>
        </visual>
        <!-- The plate, and the bolts that hold it under the chassis floor -->
        <visual>
            <origin xyz="0 0 0.02575" rpy="0 0 0"/>
            <geometry>
                <box size="0.038 0.038 0.0025"/>
            </geometry>
            <material name="grey2"/>
        </visual>
        <xacro:caster_bolt x="0.0115" y="0.0145"/>
        <xacro:caster_bolt x="0.0115" y="-0.0145"/>
        <xacro:caster_bolt x="-0.0115" y="0.0145"/>
        <xacro:caster_bolt x="-0.0115" y="-0.0145"/>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.013"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="0.1" radius="0.013">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link> 
    <gazebo reference="caster_wheel">
        <material>Gazebo/Black</material>
        <mu1 value="0.001"/>
        <mu2 value="0.001"/>
    </gazebo>

    

    <!-- ROBOT LIDAR
    <joint name="lidar_joint" type="fixed">
        <origin xyz="0.1 0 0.135" rpy="0 0 0"/>
        <parent link="chassis"/>
        <child link="lidar"/>
    </joint>

    <link name="lidar">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <geometry>
                <cylinder radius="0.035" length="0.065"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>

            <geometry>
                <cylinder radius="0.035" length="0.065"/>
            </geometry>
        </collision>
    </link> 
    <gazebo reference="lidar">
        <material>Gazebo/Red</material>
    </gazebo> -->
    
</robot>
