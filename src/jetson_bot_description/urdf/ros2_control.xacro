<?xml version="1.0"?>
<!-- autoJetsonBot/src/my_robot_launch/urdf/ros2_control.xacro -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:unless value="$(arg sim_mode)">
        <!-- Hardware path uses standalone Python bridge (jetson_bot_diffdrive)
             NOT the ros2_control hardware plugin. The old diffdrive_arduino plugin
             is intentionally omitted here to prevent "plugin not found" issues. -->
    </xacro:unless>

    <xacro:if value="$(arg sim_mode)">
        <ros2_control name="GazeboSystem" type="system">
            <hardware>
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>
            <joint name="left_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">-10</param>
                    <param name="max">50</param>
                </command_interface>
                <state_interface name="velocity"/>
                <state_interface name="position"/>
            </joint>
            <joint name="right_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">-10</param>
                    <param name="max">50</param>
                </command_interface>
                <state_interface name="velocity"/>
                <state_interface name="position"/>
            </joint>
        </ros2_control>
        <gazebo>
            <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
                <parameters>$(find jetson_bot_bringup)/config/unified_robot_config.yaml</parameters>
                <ros>
                    <remapping>/diff_cont/cmd_vel_unstamped:=/cmd_vel</remapping>
                    <remapping>/diff_cont/odom:=/odom</remapping>
                </ros>
            </plugin>
        </gazebo>
    </xacro:if>

</robot>